OPENAI_API_KEY=sk-xxx
USER=user

# LLM Configuration (optional - defaults to openai/gpt-4o-mini)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:latest
# LLM_API_KEY=
# LLM_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434

# Embedder Configuration (optional - defaults to openai/text-embedding-3-small)
# EMBEDDER_PROVIDER=ollama
# EMBEDDER_MODEL=nomic-embed-text
# EMBEDDER_API_KEY=
# EMBEDDER_BASE_URL=

# OIDC / JWT authentication (optional – enables multi-user MCP via OAuth)
# Set to your Keycloak realm URL to enable JWT-based user identity.
# When empty, authenticated MCP routes return 503 and old URL-based routes still work.
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/my_realm
# OIDC_AUDIENCE=  # optional, for future audience validation
